{
  "name": "voice-typing",
  "productName": "Voice Typing",
  "description": "Desktop voice typing with Soniox and OpenAI",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "desktopName": "io.github.sonioxvoicetyping.desktop",
  "scripts": {
    "start": "node electron/launch.cjs",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "koffi": "^3.3.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.sonioxvoicetyping",
    "files": ["electron/**/*", "package.json"],
    "asarUnpack": ["**/node_modules/@koromix/koffi-*/**", "**/node_modules/koffi/**"],
    "npmRebuild": false,
    "win": {
      "target": "portable",
      "artifactName": "Voice-Typing-${version}-${arch}.exe"
    },
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "音声入力のため、録音中にマイクを使用します。"
      }
    },
    "linux": {
      "category": "Utility",
      "syncDesktopName": true,
      "executableName": "voice-typing"
    }
  }
}
